# ==============================================================================
# JASMINE SERVICES - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env pada hosting production Anda (Laravel Cloud / VPS).
# JANGAN PERNAH menyimpan credential atau password asli di dalam Git repository!
# ==============================================================================

# --- APPLICATION SETTINGS ---
APP_NAME="Jasmine Services"
APP_ENV=production
APP_KEY=
# PENTING: Generate APP_KEY di server dengan: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://jasmineservices.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# --- LOGGING ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- DATABASE CONFIGURATION (MySQL Production) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jasmineservices_prod
DB_USERNAME=jasmineservices_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# --- SESSION & CACHE CONFIGURATION ---
# Database driver dipilih agar session persisten dan multi-worker safe
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=jasmine_cache_

# --- QUEUE SYSTEM ---
# Default database jika queue worker dijalankan (php artisan queue:work)
# Atau 'sync' jika ingin pemrosesan langsung tanpa background worker
QUEUE_CONNECTION=sync

# --- FILE STORAGE CONFIGURATION ---
# 'public' untuk hosting VPS/Laravel Cloud dengan persistent volume + symlink (php artisan storage:link)
# 's3' jika menggunakan cloud object storage (AWS S3, Cloudflare R2, MinIO, dll)
FILESYSTEM_DISK=local
FILESYSTEM_UPLOAD_DISK=public

# AWS S3 / Cloudflare R2 / MinIO (Hanya jika FILESYSTEM_UPLOAD_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=
AWS_URL=

# --- MAIL CONFIGURATION (SMTP) ---
# Booking & Contact saat ini langsung terintegrasi dengan WhatsApp Admin.
# Konfigurasi SMTP di bawah ini disiapkan jika notifikasi email diaktifkan.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="halo@jasmineservices.id"
MAIL_FROM_NAME="Jasmine Services"

# --- VITE ASSET CONFIGURATION ---
# Di server production, assets sudah dikompilasi via `npm run build`
# Tidak memerlukan Node.js atau vite dev server berjalan di production.
VITE_APP_NAME="${APP_NAME}"

